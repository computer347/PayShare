{
  "name": "payshare",
  "version": "1.0.0",
  "description": "Any bill, any group, one tab — PayPal + AI group splitting",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "smoke": "node --env-file=.env smoke.js",
