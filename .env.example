# From developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PORT=3000
# A second sandbox account that plays "the friend who paid the bill" (not your app's business account)
PAYEE_EMAIL=
# aistudio.google.com > Get API key (used to read receipt photos)
GEMINI_API_KEY=
# Or use Vertex AI instead of a key: your Google Cloud project ID (auth: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
